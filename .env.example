# On Vercel these are provided by the Supabase integration. For local
# development outside v0, copy them into .env.local.
# Supabase public configuration (publishable key only; RLS enforces access).
# Without these, the app still runs and Supabase session refresh is skipped.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Never add the service-role or secret key with a NEXT_PUBLIC_ prefix.

# Future server-side OpenAI integration only. Never prefix secrets NEXT_PUBLIC_.
# OPENAI_API_KEY=

# Optional local Supabase callback URL when auth is implemented.
# NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL=http://localhost:3000/auth/callback
