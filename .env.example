# The foundation runs without any environment variables or external services.
# Reserved examples only: no client or provider is initialized by this release.
# Future Supabase public configuration (publishable key only; enforce RLS).
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Future server-side OpenAI integration only. Never prefix secrets NEXT_PUBLIC_.
# OPENAI_API_KEY=

# Optional local Supabase callback URL when auth is implemented.
# NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL=http://localhost:3000/auth/callback
